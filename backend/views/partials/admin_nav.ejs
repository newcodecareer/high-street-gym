<%
    // Admin sidebar. Prefix match keeps /admin/users/5 highlighted on Users.
    // On phones the links use a two-column grid.
    const path = currentPath || ""
    const resources = [
        { label: "Users",      href: "/admin/users" },
        { label: "Activities", href: "/admin/activities" },
        { label: "Locations",  href: "/admin/locations" },
        { label: "Sessions",   href: "/admin/sessions" },
        { label: "Bookings",   href: "/admin/bookings" },
        { label: "Posts",      href: "/admin/posts" },
    ]
%>
<aside class="lg:w-56 shrink-0 lg:sticky lg:top-6 lg:self-start">
    <nav class="grid grid-cols-2 gap-2 lg:flex lg:flex-col lg:gap-1 bg-white rounded-xl border border-brand-500 shadow-xs p-2 mb-4">
        <% for (const resource of resources) { %>
            <% const active = path == resource.href || path.startsWith(resource.href + "/") %>
            <a
                href="<%= resource.href %>"
                class="block px-3 py-2 lg:px-4 lg:py-7 rounded-lg text-sm <%= active ? "bg-brand-500 text-slate-900 font-semibold" : "font-medium text-slate-700 hover:bg-brand-100 hover:text-brand-800" %>">
                <%= resource.label %>
            </a>
        <% } %>
    </nav>
</aside>
