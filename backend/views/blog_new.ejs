<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head.ejs") %>
    <title>New Post - High Street Gym</title>
</head>
<body class="bg-slate-100 min-h-screen flex flex-col">
    <%- include("partials/header.ejs") %>

    <main class="flex-1 w-full max-w-2xl mx-auto px-4 sm:px-6 py-8">
        <div class="card">
            <h2 class="text-xl font-bold text-slate-900 mb-6">Create a post</h2>
            <form action="/blog/new" method="post" class="space-y-4">
                <div>
                    <label for="subject" class="label">Subject</label>
                    <input type="text" name="subject" id="subject" class="input" maxlength="120" required />
                </div>
                <div>
                    <label for="body" class="label">Body</label>
                    <textarea name="body" id="body" rows="6" class="input" maxlength="5000" required></textarea>
                </div>
                <div class="flex items-center gap-3">
                    <button type="submit" class="btn btn-primary">Publish</button>
                    <a href="/blog" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </main>

    <%- include("partials/footer.ejs") %>
</body>
</html>
