<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head.ejs") %>
    <title>Login - High Street Gym</title>
</head>
<body class="bg-slate-100 min-h-screen flex flex-col">
    <%- include("partials/header.ejs") %>
    <main class="flex-1 w-full max-w-md mx-auto px-4 py-12">
        <div class="card">
            <h2 class="text-xl font-bold text-slate-900">Welcome back</h2>
            <p class="text-sm text-slate-500 mt-1 mb-6">Log in to book sessions and manage your account.</p>

            <form action="/authenticate/login" method="post" class="space-y-4">
                <div>
                    <label for="email" class="label">Email</label>
                    <input type="email" name="email" id="email" class="input" maxlength="254" required />
                </div>
                <div>
                    <label for="password" class="label">Password</label>
                    <input type="password" name="password" id="password" class="input" maxlength="200" required />
                </div>
                <button type="submit" class="btn btn-primary w-full">Login</button>
            </form>

            <p class="text-sm text-slate-500 mt-6 text-center">
                New to High Street Gym?
                <a href="/authenticate/register" class="text-brand-700 font-semibold hover:underline">Create an account</a>
            </p>
        </div>
    </main>
    <%- include("partials/footer.ejs") %>
</body>
</html>
