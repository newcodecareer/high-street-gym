<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../partials/head.ejs") %>
    <title>Manage Activities - High Street Gym</title>
</head>
<body class="bg-slate-100 min-h-screen flex flex-col">
    <%- include("../partials/header.ejs") %>

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Manage activities</h2>

        <div class="flex flex-col lg:flex-row lg:gap-6">
            <%- include("../partials/admin_nav.ejs") %>
            <div class="flex-1 min-w-0">
                <form action="/admin/activities" method="get" class="flex gap-2 mb-6">
                    <input type="text" name="search_term" value="<%= searchTerm %>" maxlength="100" placeholder="Search by name or description..." class="input max-w-sm" />
                    <button type="submit" class="btn btn-outline">Search</button>
                    <% if (searchTerm) { %>
                        <a href="/admin/activities" class="btn btn-outline">Clear</a>
                    <% } %>
                </form>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
                    <div class="card">
                        <%# Below md the description moves under the name. %>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="text-left text-slate-500 border-b border-slate-200">
                                        <th class="py-2 pr-3 font-medium">Name</th>
                                        <th class="py-2 pr-3 font-medium max-md:hidden">Description</th>
                                        <th class="py-2"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% for (const activity of activities) { %>
                                        <tr class="border-b border-slate-100">
                                            <td class="py-2 pr-3 font-medium">
                                                <%= activity.name %>
                                                <div class="text-xs text-slate-500 font-normal md:hidden">
                                                    <%= activity.description %>
                                                </div>
                                            </td>
                                            <td class="py-2 pr-3 text-slate-500 max-md:hidden"><%= activity.description %></td>
                                            <td class="py-2 text-right">
                                                <a href="/admin/activities/<%= activity.id %>" class="btn-link">Edit</a>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <%- include("../partials/table_view_more.ejs") %>
                    </div>

                    <form
                        action="/admin/activities<% if (selectedActivity.id != null) { %>/<%= selectedActivity.id %><% } %>"
                        method="post"
                        class="card space-y-4">
                        <div>
                            <label for="name" class="label">Name</label>
                            <input type="text" name="name" id="name" class="input" maxlength="80" value="<%= selectedActivity.name %>" />
                        </div>
                        <div>
                            <label for="description" class="label">Description</label>
                            <textarea name="description" id="description" rows="4" class="input" maxlength="1000"><%= selectedActivity.description %></textarea>
                        </div>
                        <div class="flex items-center gap-3 pt-2">
                            <a href="/admin/activities" class="btn btn-outline">Clear</a>
                            <% if (selectedActivity.id == null) { %>
                                <button type="submit" name="action" value="create" class="btn btn-primary">Create</button>
                            <% } else { %>
                                <button type="submit" name="action" value="update" class="btn btn-primary">Update</button>
                                <button type="submit" name="action" value="delete" class="btn btn-danger">Delete</button>
                            <% } %>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <%- include("../partials/footer.ejs") %>
</body>
</html>
